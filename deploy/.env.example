# Copie para ".env" e preencha. NUNCA suba o .env para o GitHub.
DOMAIN=app.seudominio.com.br
POSTGRES_PASSWORD=
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Chave que cifra os prontuários (obrigatória). Gere com:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# FAÇA CÓPIA FORA DO SERVIDOR (gerenciador de senhas): sem ela, nem o backup do banco abre os prontuários.
# Para trocar: PRONTUARIO_KEYS=NOVA,ANTIGA (a primeira cifra; todas decifram).
PRONTUARIO_KEYS=
# Videochamada das sessões online (Jitsi Meet próprio com JWT; veja docs/VIDEO.md). Vazio = desligada.
VIDEO_DOMAIN=
VIDEO_APP_ID=mente-saudavel
VIDEO_APP_SECRET=
# true = cria contas e dados de demonstração (só para testes; deixe false em produção)
DEMO_SEED=false
TZ=America/Sao_Paulo
# Fuso dos horários das sessões (a tela mostra "horário de Brasília")
APP_TZ=America/Sao_Paulo
# E-mail transacional (recuperar senha / confirmar e-mail). Preencha SMTP_HOST e SMTP_FROM para LIGAR.
# Com e-mail ligado, o paciente precisa confirmar o e-mail antes de agendar. Veja docs/LANCAMENTO-CHECKLIST.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Ajustes opcionais (os valores abaixo são os padrões; só mexa se souber o motivo)
LOG_LEVEL=INFO
# Validade da sessão em horas (24 = padrão de produção; "Sair" revoga a sessão em todos os aparelhos)
JWT_TTL_HOURS=24
# Único IP em quem a API confia para ler o IP real do cliente (o Caddy, IP fixo no compose de produção)
FORWARDED_ALLOW_IPS=172.31.250.10
PASSWORD_MIN=8
SIGNUP_MAX_ATTEMPTS=10
TELEMETRY_MAX_PER_MINUTE=30
CODIGO_VALIDADE_MIN=15
# Tamanho máximo do corpo de uma requisição, em bytes (padrão 1 MB)
MAX_BODY_BYTES=1000000
# Token para ler /api/metricas (vazio = desligado). Gere com: openssl rand -hex 24
METRICS_TOKEN=
# Hora do backup diário (HH:MM, no fuso TZ)
BACKUP_HORA=03:00
