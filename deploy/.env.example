# Copie para ".env" e preencha. NUNCA suba o .env para o GitHub.
DOMAIN=app.seudominio.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Chave que cifra os prontuários (obrigatória). Gere com:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# FAÇA CÓPIA FORA DO SERVIDOR (gerenciador de senhas): sem ela, nem o backup do banco abre os prontuários.
# Para trocar: PRONTUARIO_KEYS=NOVA,ANTIGA (a primeira cifra; todas decifram).
PRONTUARIO_KEYS=
# Videochamada das sessões online (Jitsi Meet próprio com JWT; veja docs/VIDEO.md). Vazio = desligada.
VIDEO_DOMAIN=
VIDEO_APP_ID=mente-saudavel
VIDEO_APP_SECRET=
# true = cria contas e dados de demonstração (só para testes; deixe false em produção)
DEMO_SEED=false
TZ=America/Sao_Paulo
# Token para ler /api/metricas (vazio = desligado). Gere com: openssl rand -hex 24
METRICS_TOKEN=
# Hora do backup diário (HH:MM, no fuso TZ)
BACKUP_HORA=03:00
