# HTTPS automático (Let's Encrypt) para o domínio definido em DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# /api/* vai para a API (o prefixo /api é removido).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Todo o resto é o site Flutter (SPA: rotas desconhecidas voltam ao index.html).
	handle {
		# Política de Segurança de Conteúdo. O site é compilado com --no-web-resources-cdn, então o
		# CanvasKit vem do próprio domínio. Liberações, e por quê:
		#  - 'wasm-unsafe-eval': o CanvasKit é WebAssembly (não permite eval de JavaScript);
		#  - style 'unsafe-inline': o Flutter cria <style> e estilos em tempo de execução;
		#  - fonts.gstatic.com (connect/font): fontes de reserva (texto/emoji) do Flutter web;
		#  - brasilapi/viacep: as duas APIs públicas de CEP e feriados que o app chama;
		#  - blob:/data: para imagens e workers que o próprio Flutter gera.
		# A API fica em /api (mesmo domínio), então 'self' basta para ela.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://brasilapi.com.br https://viacep.com.br https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Cache: o site inteiro REVALIDA a cada visita (ETag; é barato e garante que um deploy novo
		# apareça na hora, inclusive index.html, flutter_service_worker.js e manifest.json). Só o que
		# não muda entre builds (CanvasKit e ícones) fica em cache por 1 dia. O Service Worker do
		# Flutter cuida do cache offline dos demais arquivos e se atualiza sozinho a cada versão.
		@estatico path /canvaskit/* /icons/*
		header @estatico Cache-Control "public, max-age=86400"
		@dinamico not path /canvaskit/* /icons/*
		header @dinamico Cache-Control "no-cache"

		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
